DATABASE_URL=postgresql://mlimani:change_me@db:5432/mlimanifleet?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=4000
WEB_ORIGINS=http://localhost:5173,https://app.mlimani.net,https://erp.mlimani.net
APP_URL=https://app.mlimani.net
DEFAULT_CURRENCY=TZS
SELCOM_BASE_URL=https://example.invalid
SELCOM_API_KEY=
SELCOM_API_SECRET=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_TOKEN=
PAYMENT_WEBHOOK_SECRET=replace-this

# First-run super-admin provisioning only; use a unique long password
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-unique-14-character-or-longer-password
SUPER_ADMIN_NAME=MlimaniFleet Super Admin

# GPS tracking via a private Traccar server. Keep these credentials server-side only.
TRACCAR_URL=https://your-traccar-server.example
TRACCAR_USERNAME=mlimanifleet-api
TRACCAR_PASSWORD=replace-with-a-long-unique-password
GPS_RETENTION_DAYS=90

# Scheduled payment reminders (Resend email; credentials stay server-side)
RESEND_API_KEY=
REMINDER_FROM_EMAIL=accounts@example.com
# Twilio SMS is optional. External customer/supplier SMS stays disabled unless explicitly enabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ENABLE_EXTERNAL_DUE_REMINDERS=false
